{
  "name": "pcsx2-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser page layer for the PCSX2 wasm port: runtime, storage, unit and capability pages plus the Playwright lanes.",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:assets": "node scripts/stage-assets.mjs",
    "postinstall": "yarn prepare:assets",
    "dev": "vite --host 0.0.0.0",
    "build": "yarn prepare:assets && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:core": "bash scripts/build-pcsx2-core.sh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:gpu": "playwright test --config playwright.gpu.config.ts",
    "test:units:browser": "yarn build && playwright test browser-units.spec.ts",
    "device:origin": "node scripts/run-origin-device.mjs",
    "device:runtime": "node scripts/run-injected-device.mjs",
    "device:local": "node scripts/run-injected-local.mjs",
    "storage:import-host": "import-host-opfs --url http://127.0.0.1:4193 --page /storage.html",
    "storage:inspect": "inspect-opfs --url http://127.0.0.1:4193 --page /storage.html",
    "serve-library": "node scripts/serve-library.mjs --port 4195",
    "oracle:record": "bash scripts/oracle-record.sh",
    "compare:frame": "compare-frames",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@appmana-public/disc-images": "https://github.com/AppMana/web-emulator-kit.git#workspace=@appmana-public/disc-images&commit=0285bf79efcd61d93df5648c42440c2628083810",
    "@appmana-public/web-emulator-harness": "https://github.com/AppMana/web-emulator-kit.git#workspace=@appmana-public/web-emulator-harness&commit=0285bf79efcd61d93df5648c42440c2628083810"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/pngjs": "6.0.5",
    "@webgpu/types": "0.1.64",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "smol-toml": "1.8.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
